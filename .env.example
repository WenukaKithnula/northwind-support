# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# The key that signs sign-in tokens (at least 32 bytes). In Development a local, non-secret key is
# read from appsettings.Development.json and nothing needs setting. Anywhere else the API refuses
# to start without one: set a long random value here or in the real environment, and never commit
# it. Generate one with: openssl rand -base64 48
# Jwt__SigningKey=replace-with-a-long-random-value

# Applies migrations and seeds the demo data at startup. On in Development (see
# appsettings.Development.json); anywhere else it is off unless set, and a real deployment would
# run migrations as a separate step instead.
# Database__MigrateAndSeed=true

# --- API container (docker compose up) -----------------------------------------------------------
# The API image holds no configuration: compose passes these in when it starts the container.
# The signing key for the container. The default in docker-compose.yml is a local, non-secret
# fixture; anywhere real, set a long random value (openssl rand -base64 48) and never commit it.
# JWT_SIGNING_KEY=replace-with-a-long-random-value

# The environment name the API container runs as. Production (the default) turns Swagger off.
# It has its own name so the ASPNETCORE_ENVIRONMENT above, which is for running the API from
# source, does not change the container.
# ASPNETCORE_ENVIRONMENT_API=Production

# Local development login (seeded, hashed in the database). Every seeded agent shares it:
#   email:    alex.turner@northwind-support.example
#   password: LocalDevOnly-Password-1
# Yuki Tanaka is inactive and cannot sign in. This is a local fixture, not a real credential.
